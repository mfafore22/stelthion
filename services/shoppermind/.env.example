# ShopperMind service env template.
# Copy to .env for local development.

NODE_ENV=development
PORT=4000

# Service-owned Postgres. Must not be shared with the mall app.
DATABASE_URL=postgres://shoppermind:shoppermind@localhost:55432/shoppermind_db

# Redis backing the BullMQ queues.
REDIS_URL=redis://localhost:56379

# Public bearer token accepted on /v1/* by the mall app.
SHOPPERMIND_SERVICE_TOKEN=dev-local-token

# Internal bearer token accepted on /internal/* (cron trigger, health).
SHOPPERMIND_INTERNAL_TOKEN=dev-internal-token

# LLM / embedding provider keys forwarded from engine config (same values as the mall app today).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Log level: debug | info | warn | error
LOG_LEVEL=info
