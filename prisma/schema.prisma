generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  stats     Stats?
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  name             String
  role             Role     @default(USER)
  customerId       String
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id])
}

model Stats {
  id              String   @id @default(cuid())
  customerId      String   @unique
  totalUnits      Int      @default(0)
  topCategory     String   @default("N/A")
  foodBeverage    Float    @default(0)
  fashionRetail   Float    @default(0)
  currentVisitors Int      @default(0)
  dwellTime       Int      @default(0)
  conversionRate  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id])
}


enum Role {
  ADMIN
  MANAGER
  USER
}
