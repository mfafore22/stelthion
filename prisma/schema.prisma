generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant / Auth ──────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  malls     Mall[]
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String
  role                Role      @default(USER)
  customerId          String
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  MANAGER
  USER
}

// ─── Email OTP ──────────────────────────────────────────────────────────────

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

// ─── Mall ───────────────────────────────────────────────────────────────────

model Mall {
  id          String     @id @default(cuid())
  mallId      String     @unique
  name        String
  city        String
  address     String?
  totalShops  Int        @default(0)
  status      MallStatus @default(LIVE)
  customerId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stats       MallStats?
  branding    MallBranding?
  categories  MallCategory[]
  zones       FloorplanZone[]
  cameras     Camera[]
  jobs        AnalysisJob[]
  snapshots   FloorplanSnapshot[]
  footfall    FootfallReading[]
  household   HouseholdStat[]
  events      MallEvent[]
  edgeDevices EdgeDevice[]
}

enum MallStatus {
  LIVE
  BETA
  ALPHA
  PLANNED
}

model MallStats {
  id              String   @id @default(cuid())
  mallId          String   @unique
  currentVisitors Int      @default(0)
  annualVisitors  Int      @default(0)
  annualSales     Float    @default(0)
  dwellTime       Int      @default(0)
  conversionRate  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mall            Mall     @relation(fields: [mallId], references: [mallId], onDelete: Cascade)
}

model MallBranding {
  id              String   @id @default(cuid())
  mallId          String   @unique
  logo            String?
  primaryColor    String   @default("#1e40af")
  secondaryColor  String   @default("#3b82f6")
  accentColor     String   @default("#60a5fa")
  backgroundColor String   @default("#F8F6F3")
  warningColor    String   @default("#f7966b")
  errorColor      String   @default("#f04e54")
  gradientFrom    String   @default("#264d21")
  gradientTo      String   @default("#1a3a15")
  fontFamily      String   @default("Inter, sans-serif")
  headingWeight   Int      @default(700)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mall            Mall     @relation(fields: [mallId], references: [mallId], onDelete: Cascade)
}

model MallCategory {
  id         String @id @default(cuid())
  mallId     String
  name       String
  shopCount  Int    @default(0)
  percentage Float  @default(0)
  mall       Mall   @relation(fields: [mallId], references: [mallId], onDelete: Cascade)

  @@unique([mallId, name])
}

// ─── Floor Plan & Video Analysis ────────────────────────────────────────────

model FloorplanZone {
  id           String    @id @default(cuid())
  mallId       String
  floor        String
  zoneId       String
  name         String
  nameFi       String
  category     String
  subcategory  String?
  drawShape    String    @default("polygon")
  svgPoints    String
  labelX       Float
  labelY       Float
  capacity     Int
  areaSqm      Int
  baseVisitors Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  mall    Mall     @relation(fields: [mallId], references: [mallId], onDelete: Cascade)
  cameras Camera[]

  @@unique([mallId, floor, zoneId])
}

model Camera {
  id               String    @id @default(cuid())
  mallId           String
  floor            String
  label            String
  x                Float
  y                Float
  model            String?
  resolution       String?
  lensInfo         String?
  cameraRole       String?
  angleDeg         Float?
  fovDeg           Float?
  rangeM           Float?
  streamUrl        String?
  dataSourceUrl    String?
  zoneDbId         String?
  homographyMatrix String?
  deviceType       String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mall          Mall           @relation(fields: [mallId], references: [mallId], onDelete: Cascade)
  zone          FloorplanZone? @relation(fields: [zoneDbId], references: [id])
  jobs          AnalysisJob[]  @relation("PrimaryCamera")
  jobsSecondary AnalysisJob[]  @relation("SecondaryCamera")
}

model AnalysisJob {
  id                String       @id @default(cuid())
  mallId            String
  mode              AnalysisMode @default(ZONE_COUNT)
  cameraId          String?
  secondaryCameraId String?
  footageDate       DateTime
  startTime         String
  endTime           String
  journeyCount      Int          @default(0)
  originZoneId      String?
  destinationZoneId String?
  selectedZoneIds   String?
  status            JobStatus    @default(PENDING)
  progress          Int          @default(0)
  errorMessage      String?
  edgeDeviceId      String?
  requestedBy       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  mall            Mall             @relation(fields: [mallId], references: [mallId], onDelete: Cascade)
  camera          Camera?          @relation("PrimaryCamera", fields: [cameraId], references: [id])
  secondaryCamera Camera?          @relation("SecondaryCamera", fields: [secondaryCameraId], references: [id])
  results         AnalysisResult[]
  journeys        JourneySession[]
  behaviors       StoreBehavior[]
  insights        AnalysisInsight[]
}

enum AnalysisMode {
  ZONE_COUNT
  AB_TRACKING
  JOURNEY_MAP
  STORE_BEHAVIOR
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model AnalysisResult {
  id        String      @id @default(cuid())
  jobId     String
  zoneId    String
  hour      Int
  count     Int
  density   Float
  createdAt DateTime    @default(now())

  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JourneySession {
  id              String        @id @default(cuid())
  jobId           String
  taggedCount     Int
  recognizedCount Int
  createdAt       DateTime      @default(now())

  job   AnalysisJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  paths JourneyPath[]
}

model JourneyPath {
  id           String         @id @default(cuid())
  sessionId    String
  zoneSequence String
  timestamps   String

  session JourneySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Store Behavior Analysis ────────────────────────────────────────────────

model StoreBehavior {
  id        String      @id @default(cuid())
  jobId     String
  zoneId    String
  hour      Int
  walkBy    Int         @default(0)
  stop      Int         @default(0)
  enter     Int         @default(0)
  createdAt DateTime    @default(now())

  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, zoneId, hour])
}

// ─── AI Insights ────────────────────────────────────────────────────────────

model AnalysisInsight {
  id              String      @id @default(cuid())
  jobId           String
  source          String      @default("edge")
  summary         String
  recommendations String?
  alertLevel      String      @default("info")
  createdAt       DateTime    @default(now())

  job AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─── Edge Devices ───────────────────────────────────────────────────────────

model EdgeDevice {
  id            String     @id @default(cuid())
  edgeId        String     @unique
  mallId        String
  apiKeyHash    String
  version       String?
  gpuInfo       String?
  lastHeartbeat DateTime?
  status        EdgeStatus @default(OFFLINE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  mall Mall @relation(fields: [mallId], references: [mallId], onDelete: Cascade)
}

enum EdgeStatus {
  ONLINE
  OFFLINE
  ERROR
}

// ─── Floorplan Backup Snapshots ─────────────────────────────────────────────

model FloorplanSnapshot {
  id        String   @id @default(cuid())
  mallId    String
  floor     String
  data      String
  reason    String
  createdAt DateTime @default(now())

  mall Mall @relation(fields: [mallId], references: [mallId], onDelete: Cascade)

  @@index([mallId, floor, createdAt])
}

// ─── Footfall (sensor / camera count data) ──────────────────────────────────

model FootfallReading {
  id        String   @id @default(cuid())
  mallId    String
  zoneId    String
  floor     String
  date      DateTime @db.Date
  hour      Int
  visitors  Int      @default(0)
  dwellSec  Int?
  source    String   @default("sensor")
  createdAt DateTime @default(now())

  mall Mall @relation(fields: [mallId], references: [mallId], onDelete: Cascade)

  @@unique([mallId, zoneId, floor, date, hour, source])
  @@index([mallId, date])
}

// ─── Household / Catchment (demographic data) ──────────────────────────────

model HouseholdStat {
  id           String   @id @default(cuid())
  mallId       String
  postalCode   String
  municipality String?
  population   Int      @default(0)
  households   Int      @default(0)
  avgIncome    Float?
  medianAge    Float?
  distanceKm   Float?
  driveTimeMin Float?
  year         Int
  createdAt    DateTime @default(now())

  mall Mall @relation(fields: [mallId], references: [mallId], onDelete: Cascade)

  @@unique([mallId, postalCode, year])
  @@index([mallId, year])
}

// ─── Events & Campaigns ────────────────────────────────────────────────────

model MallEvent {
  id          String        @id @default(cuid())
  mallId      String
  title       String
  titleFi     String?
  description String?
  category    EventCategory @default(OTHER)
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean       @default(false)
  location    String?
  organizer   String?
  imageUrl    String?
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mall Mall @relation(fields: [mallId], references: [mallId], onDelete: Cascade)

  @@index([mallId, startDate])
}

enum EventCategory {
  SALE
  ENTERTAINMENT
  COMMUNITY
  SEASONAL
  TENANT
  OTHER
}